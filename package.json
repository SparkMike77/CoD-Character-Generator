{
  "name": "cod-character-manager",
  "productName": "CoD Character Manager",
  "version": "0.3.0",
  "description": "Windows character manager and play tool for Chronicles of Darkness, 2nd Edition (baseline humans). Pairs with the GMScreen server for GM-driven configuration.",
  "main": "src/main.js",
  "author": "SparkMike77",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "npm run vendor && node scripts/start.js",
    "dist": "npm run vendor && electron-builder --win",
    "dist:all": "npm run dist && npm --prefix gmscreen install && npm --prefix gmscreen run dist",
    "vendor": "node scripts/vendor-three.js .",
    "avatar-assets": "node scripts/prepare-avatar-assets.js"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "three": "^0.187.0"
  },
  "build": {
    "appId": "com.sparkmike77.codcharmanager",
    "productName": "CoD Character Manager",
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  },
  "dependencies": {
    "bonjour-service": "^1.4.4"
  }
}
